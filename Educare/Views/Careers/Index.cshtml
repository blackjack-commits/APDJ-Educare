@{
    ViewData["Title"] = "Careers";
}

<section class="page-hero career-hero">

    <div class="page-hero-content">

        <p class="page-label">CAREER GUIDANCE</p>

        <h1>Discover Where Your Interests Can Take You.</h1>

        <p>
            Explore career fields, qualifications, subjects and
            possible pathways to help you make informed decisions.
        </p>

    </div>

</section>


<section class="career-intro">

    <p class="section-label">EXPLORE CAREERS</p>

    <h2>Find A Career Pathway</h2>

    <p>
        Career information will help you understand what different
        careers involve and what pathways can lead you there.
    </p>

    <div class="career-button-area">

        <a asp-controller="Assistant"
           asp-action="Index"
           class="btn btn-primary">
            Ask EducareSA AI
        </a>

    </div>

</section>