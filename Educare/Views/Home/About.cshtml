@{
    ViewData["Title"] = "About EducareSA";
}

<section class="page-hero">
    <div class="page-hero-content">
        <p class="section-label">ABOUT EDUCARE-SA</p>

        <h1>Helping You Find Your Next Opportunity.</h1>

        <p>
            EducareSA brings education, funding, training and
            career opportunities together in one platform.
        </p>
    </div>
</section>


<section class="content-page">

    <div class="about-section">

        <p class="section-label">OUR PURPOSE</p>

        <h2>Why EducareSA Exists</h2>

        <p>
            Many matriculants struggle to decide what to do after
            Grade 12. Information about universities, TVET colleges,
            bursaries, learnerships, internships and skills programmes
            can be difficult to find and understand.
        </p>

        <p>
            EducareSA aims to make this information easier to discover
            by bringing different opportunities together in one place.
        </p>

    </div>


    <div class="about-grid">

        <div class="about-card">
            <h3>🎓 Education</h3>

            <p>
                Discover universities, TVET colleges and
                educational pathways available to you.
            </p>
        </div>


        <div class="about-card">
            <h3>💰 Funding</h3>

            <p>
                Find bursaries and other funding opportunities
                that can help support your education.
            </p>
        </div>


        <div class="about-card">
            <h3>💼 Careers</h3>

            <p>
                Explore career paths and understand the
                opportunities connected to your interests.
            </p>
        </div>


        <div class="about-card">
            <h3>🤖 AI Guidance</h3>

            <p>
                Use the EducareSA AI Assistant to receive
                personalized guidance based on your profile.
            </p>
        </div>

    </div>


    <div class="about-section about-how">

        <p class="section-label">HOW IT WORKS</p>

        <h2>One Platform. More Possibilities.</h2>

        <div class="how-grid">

            <div>
                <span>01</span>
                <h3>Create Your Profile</h3>
                <p>
                    Tell EducareSA about your academic background,
                    interests and future goals.
                </p>
            </div>

            <div>
                <span>02</span>
                <h3>Explore Opportunities</h3>
                <p>
                    Search and filter education, funding and
                    career opportunities.
                </p>
            </div>

            <div>
                <span>03</span>
                <h3>Get Guidance</h3>
                <p>
                    Receive recommendations that are relevant
                    to your interests and qualifications.
                </p>
            </div>

        </div>

    </div>

</section>