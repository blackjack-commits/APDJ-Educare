@{
    ViewData["Title"] = "AI Assistant";
}

<section class="assistant-page">

    <div class="assistant-header">

        <p class="section-label">EDUCARESA AI</p>

        <h1>Your Personal Education & Career Assistant</h1>

        <p>
            Get guidance based on your subjects, interests,
            qualifications and future goals.
        </p>

    </div>


    <div class="assistant-box">

        <div class="assistant-message">

            <div class="assistant-icon">
                AI
            </div>

            <div>

                <strong>EducareSA Assistant</strong>

                <p>
                    Hi! I'm the EducareSA Assistant.
                    I'll eventually help you discover education
                    and career opportunities based on your profile.
                </p>

            </div>

        </div>


        <div class="assistant-input">

            <input type="text"
                   placeholder="Ask about careers, universities, bursaries..."
                   disabled />

            <button disabled>
                Send
            </button>

        </div>

        <small>
            AI functionality will be connected during Stage 3.
        </small>

    </div>

</section>