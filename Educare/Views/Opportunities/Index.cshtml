@{
    ViewData["Title"] = "Opportunities";
}

<section class="page-hero">

    <div class="page-hero-content">

        <p class="page-label">EXPLORE YOUR OPTIONS</p>

        <h1>Opportunities For Your Future</h1>

        <p>
            Discover education, funding, training and work opportunities
            designed to help you take your next step after matric.
        </p>

    </div>

</section>


<section class="opportunities-intro">

    <p class="section-label">WHAT ARE YOU LOOKING FOR?</p>

    <h2>Choose Your Pathway</h2>

    <p>
        Explore different opportunities and find information about
        requirements, deadlines and official application sources.
    </p>

</section>


<section class="opportunity-options">

    <a asp-controller="Opportunities"
       asp-action="Universities"
       class="large-option">

        <div>
            <span>01</span>

            <h3>Universities</h3>

            <p>
                Explore university programmes and admission requirements.
            </p>
        </div>

        <strong>→</strong>

    </a>


    <a asp-controller="Opportunities"
       asp-action="TVET"
       class="large-option">

        <div>
            <span>02</span>

            <h3>TVET Colleges</h3>

            <p>
                Discover vocational and technical education pathways.
            </p>
        </div>

        <strong>→</strong>

    </a>


    <a asp-controller="Opportunities"
       asp-action="Bursaries"
       class="large-option">

        <div>
            <span>03</span>

            <h3>Bursaries</h3>

            <p>
                Find financial support opportunities for your studies.
            </p>
        </div>

        <strong>→</strong>

    </a>


    <a asp-controller="Opportunities"
       asp-action="Learnerships"
       class="large-option">

        <div>
            <span>04</span>

            <h3>Learnerships</h3>

            <p>
                Gain practical experience while developing valuable skills.
            </p>
        </div>

        <strong>→</strong>

    </a>


    <a asp-controller="Opportunities"
       asp-action="Internships"
       class="large-option">

        <div>
            <span>05</span>

            <h3>Internships</h3>

            <p>
                Explore opportunities to gain workplace experience.
            </p>
        </div>

        <strong>→</strong>

    </a>


    <a asp-controller="Opportunities"
       asp-action="Skills"
       class="large-option">

        <div>
            <span>06</span>

            <h3>Skills Programmes</h3>

            <p>
                Discover programmes that help you develop practical skills.
            </p>
        </div>

        <strong>→</strong>

    </a>

</section>